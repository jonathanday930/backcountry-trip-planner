# Google OAuth credentials (see README for setup steps)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must exactly match an "Authorized redirect URI" on the OAuth client in Google Cloud Console.
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback

# Where the browser gets sent back to after sign-in, and the allowed CORS origin.
FRONTEND_URL=http://localhost:5173

# Set to "true" once served over HTTPS in production.
SESSION_COOKIE_SECURE=false

# Anthropic API key for the trip-planning chat widget. Get one at
# https://console.anthropic.com/settings/keys. Chat returns a friendly error if unset — see
# backend/src/llm.ts.
ANTHROPIC_API_KEY=

# Which Claude model powers the chat widget. Defaults to Haiku 4.5 if unset — change this to swap
# models without touching any code.
CHAT_MODEL=claude-haiku-4-5

# Max tokens for a single chat reply. Defaults to 1024 if unset.
CHAT_MAX_TOKENS=1024

# Which LLM provider powers the chat widget: "anthropic" (default) or "huggingface". Leave unset
# to keep using Claude/ANTHROPIC_API_KEY above — this only matters once you opt into testing the
# Hugging Face path. See backend/src/llm.ts.
LLM_PROVIDER=anthropic

# Hugging Face access token (huggingface.co/settings/tokens), only used when LLM_PROVIDER=huggingface.
# Calls go through Hugging Face's OpenAI-compatible Inference Providers router, not OpenAI itself.
HF_TOKEN=

# Which model the Hugging Face path requests, in Inference Providers' "<model>:<provider>" form.
# Defaults to Llama 3.3 70B via Novita if unset. Only used when LLM_PROVIDER=huggingface.
HF_MODEL=meta-llama/Llama-3.3-70B-Instruct:novita

# National Park Service Data API key, used by the chat widget's trail-closures tool and the map's
# hazard-pin layer (backend/src/hazards.ts) to pull each NPS park's official alerts + road-events
# feeds instead of scraping its web page. Free — sign up at
# https://www.nps.gov/subjects/developer/get-started.htm. Only affects parks with an `npsParkCode`
# set in backend/src/parks.ts; other parks are unaffected if this is left unset.
NPS_API_KEY=

# Which Hugging Face model the map's hazard layer uses to best-effort match a non-road NPS alert
# (e.g. a trail closure) to a known place's coordinates, so it can be pinned on the map. Separate
# from HF_MODEL (the chat widget's model) since this is a small single-shot classification, not a
# conversation — a small/cheap model is enough. Defaults to Llama 3.1 8B via Novita if unset. Uses
# the same HF_TOKEN above. If HF_TOKEN is unset, this matching step is simply skipped — non-road
# alerts just show in the map's "Park Alerts" list instead of getting a pin.
HAZARD_LOCATOR_MODEL=meta-llama/Llama-3.1-8B-Instruct:novita

# Where the SQLite database and elevation cache live. Defaults to backend/data if unset, which is
# fine locally. In production (Fly.io) this is set to the mounted volume path (e.g. "/data") via
# fly.toml, so the data survives deploys/restarts.
# PERSIST_DIR=
